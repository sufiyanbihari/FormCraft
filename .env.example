# FormCraft Environment Variables Template

# -------------------------------------------------------------
# Database (Neon PostgreSQL with Prisma)
# -------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# -------------------------------------------------------------
# Authentication & Application
# -------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
AUDIT_REQUIRED_EMAIL="audit-admin@example.com"
AUDIT_REQUIRED_PASSWORD="replace-with-audit-password"

# -------------------------------------------------------------
# Persistent File & Media Storage for Vercel Production
# -------------------------------------------------------------
# Active provider selection (optional, auto-detected if omitted):
# Options: 'vercel-blob' | 's3' | 'database' | 'local'
# On Vercel, if neither BLOB nor S3 credentials are set, 'database'
# (Neon PostgreSQL) is automatically used as the zero-config persistent storage.
STORAGE_PROVIDER=""

# --- Option 1: Vercel Blob Storage (Recommended for Vercel) ---
# Create via Vercel Dashboard -> Storage -> Blob.
# In Vercel, BLOB_READ_WRITE_TOKEN is injected automatically when linked.
BLOB_READ_WRITE_TOKEN=""

# --- Option 2: S3-Compatible Storage (AWS S3, Cloudflare R2, MinIO, Supabase) ---
# For AWS S3:
# S3_BUCKET="my-formcraft-uploads"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="AKIA..."
# S3_SECRET_ACCESS_KEY="..."
# S3_PUBLIC_URL="https://my-formcraft-uploads.s3.us-east-1.amazonaws.com"
#
# For Cloudflare R2:
# S3_BUCKET="my-formcraft-uploads"
# S3_REGION="auto"
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_PUBLIC_URL="https://pub-xxxx.r2.dev"
#
# S3_FORCE_PATH_STYLE="false"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"
